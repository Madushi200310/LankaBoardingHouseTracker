# Copy this file to application-local.properties (same folder) and fill in your values.
# application-local.properties is git-ignored, so your real password and secret stay private.

# ─── Database ────────────────────────────────────────────────────────────
spring.datasource.url=jdbc:postgresql://localhost:5432/lanka_boarding_house_db
spring.datasource.username=postgres
spring.datasource.password=REPLACE_WITH_YOUR_POSTGRES_PASSWORD

# ─── JWT ─────────────────────────────────────────────────────────────────
# The secret must be at least 32 characters. Generate a random value
# e.g. with:  openssl rand -base64 48
jwt.secret=REPLACE_WITH_A_LONG_RANDOM_STRING_OF_AT_LEAST_32_CHARS

# ─── Dev conveniences ────────────────────────────────────────────────────
spring.jpa.show-sql=true

# ─── Default admin seed (optional) ───────────────────────────────────────
# Leave blank to skip admin seeding.
# The password must meet PasswordPolicy (min 6 characters).
admin.email=admin@lankaboarding.lk
admin.password=REPLACE_WITH_A_STRONG_ADMIN_PASSWORD